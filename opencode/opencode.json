{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": false,
    "model": "openai/gpt-5.6-sol",
    "small_model": "openai/gpt-5.5-fast",
    "provider": {
        "lmstudio": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "LM Studio (local)",
            "options": {
                "baseURL": "http://127.0.0.1:1234/v1"
            },
            "models": {
                "google/gemma-4-26b-a4b": {
                    "name": "google/gemma-4-26b-a4b"
                },
                "zai-org/glm-4.7-flash": {
                    "name": "zai-org/glm-4.7-flash"
                },
                "qwen3.6-35b-a3b": {
                    "name": "qwen3.6-35b-a3b"
                },
                "qwen3.6-27b-mlx": {
                    "name": "qwen3.6-27b-mlx"
                }
            }
        }
    },
    "mcp": {
        "dotnet-csharp": {
            "type": "remote",
            "url": "http://127.0.0.1:8082/mcp",
            "enabled": false
        },
        "linear": {
            "type": "remote",
            "url": "https://mcp.linear.app/mcp",
            "enabled": true,
            "oauth": {}
        },
        "stytch": {
            "type": "remote",
            "url": "https://mcp.stytch.dev/mcp",
            "enabled": false,
            "oauth": {}
        },
        "customer-io": {
            "type": "remote",
            "url": "https://mcp-eu.customer.io/mcp",
            "enabled": false,
            "oauth": {}
        },
        "slack": {
            "type": "remote",
            "url": "https://mcp.slack.com/mcp",
            "enabled": false,
            "oauth": {}
        },
        "notion": {
            "type": "remote",
            "url": "https://mcp.notion.com/mcp",
            "enabled": false
        },
        "safari": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "safari-mcp"
            ],
            "enabled": false
        },
        "safari-mcp-stp": {
            "type": "local",
            "command": [
                "/Applications/Safari Technology Preview.app/Contents/MacOS/safaridriver",
                "--mcp"
            ],
            "enabled": false
        },
        "chrome-devtools": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "chrome-devtools-mcp@latest",
                "--user-data-dir=/Users/stefanbilliet/.cache/chrome-devtools-mcp/default",
                "--viewport=1440x1000",
                "--no-usage-statistics",
                "--no-performance-crux",
                "--redact-network-headers",
                "--screenshot-format=webp",
                "--screenshot-quality=80",
                "--screenshot-max-width=1600",
                "--screenshot-max-height=1200"
            ],
            "enabled": false,
            "timeout": 30000
        },
        "sonarqube": {
            "type": "remote",
            "url": "http://127.0.0.1:8083/mcp",
            "enabled": false
        },
        "cloudflare-api": {
            "type": "remote",
            "url": "https://mcp.cloudflare.com/mcp",
            "enabled": false
        },
        "statsig": {
            "type": "remote",
            "url": "https://api.statsig.com/v1/mcp",
            "enabled": false
        },
        "sentry": {
            "type": "remote",
            "url": "https://mcp.sentry.dev/mcp",
            "enabled": false,
            "oauth": {
                "scope": "org:read project:write team:write event:write"
            }
        },
        "vercel": {
            "type": "remote",
            "url": "https://mcp.vercel.com",
            "enabled": false
        },
        "fallow": {
            "type": "local",
            "command": [
                "fallow-mcp"
            ],
            "enabled": true
        },
        "codebase-memory-mcp": {
            "enabled": true,
            "type": "local",
            "command": [
                "/Users/stefanbilliet/.local/bin/codebase-memory-mcp"
            ]
        }
    },
    "plugin": [
        "@mohak34/opencode-notifier@latest"
    ],
    "instructions": [
        "./draft-text-formatting.md"
    ]
}
